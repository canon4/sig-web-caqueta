# ==============================================================
#  Variables de entorno del proyecto SIG Web Caquetá
#
#  1. Copia este archivo:   cp .env.example .env
#  2. Cambia TODAS las contraseñas en .env
#  .env está en .gitignore: NUNCA se sube al repositorio.
# ==============================================================

# --- Base de datos (PostgreSQL + PostGIS) ---
DB_HOST=localhost                 # en Docker: postgis
DB_NAME=sig_caqueta
DB_OWNER=sig_admin                # dueño de las tablas (carga los datos)
DB_OWNER_PASS=CambiaEsto_Admin
DB_APP_USER=geoserver_app         # usuario de SOLO LECTURA que usa GeoServer
DB_APP_PASS=CambiaEsto_App

# --- GeoServer ---
GS_VERSION=3.0.2                  # versión estable: verifica en geoserver.org/download
GS_URL=http://127.0.0.1:8080/geoserver   # instalación nativa; en Docker lo fija compose.yaml
GS_HOME=/opt/geoserver
GS_DATA_DIR=/var/lib/geoserver_data
GS_ADMIN_PASS=CambiaEsto_GeoServer   # reemplaza la clave por defecto admin/geoserver
GS_WORKSPACE=caqueta
GS_STORE=postgis_caqueta
GS_JAVA_MEM="-Xms512m -Xmx1536m"  # ajusta según la RAM del servidor

# --- Puertos de Docker (siempre publicados SOLO en 127.0.0.1) ---
DB_PORT=5432                      # PostGIS, para QGIS/DBeaver por túnel SSH
GS_PORT=8086                      # panel de GeoServer por túnel SSH
WEB_PORT=8090                     # visor; Apache/Nginx del servidor reenvía aquí

# --- Web (solo instalación nativa, infra/scripts/06) ---
WEB_ROOT=/var/www/sig-caqueta
PUBLIC_HOST=_                     # "_" = cualquier IP/host. Con dominio: sig.midominio.com
